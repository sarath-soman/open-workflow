{
  "name": "open-workflow",
  "version": "0.1.0",
  "private": true,
  "description": "Source-compatible runtime for Claude Code-style workflow scripts with pluggable agent adapters.",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "ow": "bun packages/cli/src/index.ts",
    "owf": "bun packages/cli/src/index.ts",
    "check": "bun run check:types && bun run check:biome",
    "check:types": "bunx tsc --noEmit -p tsconfig.check.json",
    "check:biome": "bunx biome check .",
    "format": "bunx biome format --write .",
    "build": "bun build --compile packages/cli/src/index.ts --outfile dist/owf",
    "build:all": "bash scripts/build.sh",
    "smoke": "bun packages/cli/src/index.ts run hello --adapter mock --args '{\"topic\":\"workflow runtime\"}' --output json"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/bun": "latest",
    "typescript": "latest"
  },
  "license": "MIT"
}
